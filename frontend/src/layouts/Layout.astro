---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title} — Inventario TI</title>
    <meta name="description" content="Sistema de Inventario de Tecnología, Mantenimiento y Galería Cifrada" />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <nav class="bg-slate-900 text-white px-4 sm:px-6 py-3 sm:py-4 flex justify-between items-center sticky top-0 z-50">
      <a href="/" class="font-bold text-base sm:text-lg tracking-tight inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg> Inventario <span class="text-sky-400">TI</span></a>
       <!-- Desktop nav -->
      <div class="hidden md:flex gap-6 text-sm items-center">
        <a href="/" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg> Activos</a>
        <a href="/estadisticas" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg> Estadísticas</a>
        <a href="/calendario" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> Calendario</a>
        <a href="/etiquetas" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg> Etiquetas</a>
        <a href="/frascos" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v8"/><path d="M12 22a7 7 0 0 0 7-7c0-3.5-2-6-7-11-5 5-7 7.5-7 11a7 7 0 0 0 7 7z"/></svg> Frascos</a>
        <a href="/escaner" class="hover:text-sky-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="12" x2="12" y1="12" y2="12"/><line x1="7" x2="17" y1="12" y2="12" opacity="0.3"/></svg> Escanear</a>
        <a href="/?estado=dado_de_baja" class="hover:text-rose-400 transition inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg> Bajas</a>
        <a href="/dispositivos/nuevo" id="nav-nuevo-desktop" class="bg-sky-600 hover:bg-sky-500 px-4 py-1.5 rounded-full text-white font-medium transition inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Nuevo</a>
        <span id="nav-user-desktop" class="hidden text-xs bg-slate-800 px-3 py-1.5 rounded-full inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> <span id="nav-user-text-desktop"></span></span>
        <button id="nav-logout-desktop" class="hidden text-xs border border-slate-700 px-3 py-1.5 rounded-full hover:bg-slate-800 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg> Salir</button>
      </div>
      <!-- Mobile hamburger -->
      <div class="md:hidden flex items-center gap-2">
        <a href="/dispositivos/nuevo" class="bg-sky-600 px-3 py-2 rounded-full text-white text-xs font-bold inline-flex items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg> Nuevo</a>
        <button id="mobile-menu-btn" aria-label="Menú" class="p-2 rounded-lg border border-slate-700 hover:bg-slate-800">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </nav>
    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden md:hidden bg-slate-900 text-white border-t border-slate-800 sticky top-[57px] z-40">
      <div class="flex flex-col p-4 gap-3 text-sm">
        <a href="/" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg> Activos</a>
        <a href="/estadisticas" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg> Estadísticas</a>
        <a href="/calendario" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> Calendario</a>
        <a href="/etiquetas" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" x2="7.01" y1="7" y2="7"/></svg> Etiquetas</a>
        <a href="/frascos" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v8"/><path d="M12 22a7 7 0 0 0 7-7c0-3.5-2-6-7-11-5 5-7 7.5-7 11a7 7 0 0 0 7 7z"/></svg> Frascos</a>
        <a href="/escaner" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg> Escanear</a>
        <a href="/?estado=dado_de_baja" class="py-2.5 px-3 rounded-lg hover:bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg> Bajas</a>
        <div id="nav-user-mobile" class="hidden text-xs text-slate-400 px-3 py-2 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> <span id="nav-user-text-mobile"></span></div>
        <button id="nav-logout-mobile" class="hidden text-left py-2.5 px-3 rounded-lg bg-slate-800 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg> Salir</button>
      </div>
    </div>
    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => menu.classList.toggle('hidden'));
        menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.classList.add('hidden')));
      }
      // patch fetch para enviar token automáticamente (componentes React siguen usando fetch sin cambios)
      (function() {
        const origFetch = window.fetch;
        window.fetch = function(input, init = {}) {
          const token = localStorage.getItem('token');
          const url = typeof input === 'string' ? input : input.url;
          // solo para /api mismo origen
          if (token && url && url.includes('/api/')) {
            init.headers = { ...(init.headers || {}), Authorization: 'Bearer ' + token };
          }
          return origFetch(input, init).then(res => {
            const isLogin = location.pathname === '/login' || location.pathname.startsWith('/login/');
            if (res.status === 401 && !isLogin && url && url.includes('/api/')) {
              localStorage.removeItem('token');
              localStorage.removeItem('usuario');
              location.href = '/login';
            }
            return res;
          });
        };
      })();
      // auth guard + user badge (token-based, sin JWT)
      (function() {
        const token = localStorage.getItem('token');
        const raw = localStorage.getItem('usuario');
        const path = location.pathname;
        const isLogin = path === '/login' || path.startsWith('/login/');
        if (!token && !isLogin) {
          location.href = '/login';
          return;
        }
        if (token && raw) {
          try {
            const u = JSON.parse(raw);
            const label = u.username + ' · ' + u.rol;
            const d = document.getElementById('nav-user-desktop');
            const m = document.getElementById('nav-user-mobile');
            const dt = document.getElementById('nav-user-text-desktop');
            const mt = document.getElementById('nav-user-text-mobile');
            const ld = document.getElementById('nav-logout-desktop');
            const lm = document.getElementById('nav-logout-mobile');
            const nuevo = document.getElementById('nav-nuevo-desktop');
            if (d) d.classList.remove('hidden');
            if (m) m.classList.remove('hidden');
            if (dt) dt.textContent = label;
            if (mt) mt.textContent = label;
            if (ld) ld.classList.remove('hidden');
            if (lm) lm.classList.remove('hidden');
            if (nuevo && u.rol !== 'tecnico') { nuevo.classList.add('hidden'); }
          } catch {}
        }
        function doLogout() {
          const tok = localStorage.getItem('token');
          if (tok) fetch('/api/auth/logout', { method:'POST', headers:{ Authorization:'Bearer '+tok }}).catch(()=>{});
          localStorage.removeItem('token');
          localStorage.removeItem('usuario');
          location.href = '/login';
        }
        const ld = document.getElementById('nav-logout-desktop');
        const lm = document.getElementById('nav-logout-mobile');
        if (ld) ld.addEventListener('click', doLogout);
        if (lm) lm.addEventListener('click', doLogout);
      })();
    </script>
    <slot />
    <footer class="text-center text-xs text-slate-400 py-8 mt-12 border-t border-slate-200">
      Sistema de Inventario TI — Golang + Astro + AES-256-GCM — {new Date().getFullYear()}
    </footer>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>
