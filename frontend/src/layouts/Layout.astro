---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <title>{title} — Inventario TI</title>
    <meta name="description" content="Sistema de Inventario de Tecnología, Mantenimiento y Galería Cifrada" />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <nav class="bg-slate-900 text-white px-4 sm:px-6 py-3 sm:py-4 flex justify-between items-center sticky top-0 z-50">
      <a href="/" class="font-bold text-base sm:text-lg tracking-tight">🖥️ Inventario <span class="text-sky-400">TI</span></a>
       <!-- Desktop nav -->
      <div class="hidden md:flex gap-6 text-sm items-center">
        <a href="/" class="hover:text-sky-400 transition">Activos</a>
        <a href="/estadisticas" class="hover:text-sky-400 transition">📊 Estadísticas</a>
        <a href="/calendario" class="hover:text-sky-400 transition">📅 Calendario</a>
        <a href="/etiquetas" class="hover:text-sky-400 transition">🏷️ Etiquetas</a>
        <a href="/escaner" class="hover:text-sky-400 transition">🔍 Escanear</a>
        <a href="/?estado=dado_de_baja" class="hover:text-rose-400 transition">Bajas</a>
        <a href="/dispositivos/nuevo" id="nav-nuevo-desktop" class="bg-sky-600 hover:bg-sky-500 px-4 py-1.5 rounded-full text-white font-medium transition">+ Nuevo</a>
        <span id="nav-user-desktop" class="hidden text-xs bg-slate-800 px-3 py-1.5 rounded-full"></span>
        <button id="nav-logout-desktop" class="hidden text-xs border border-slate-700 px-3 py-1.5 rounded-full hover:bg-slate-800">Salir</button>
      </div>
      <!-- Mobile hamburger -->
      <div class="md:hidden flex items-center gap-2">
        <a href="/dispositivos/nuevo" class="bg-sky-600 px-3 py-2 rounded-full text-white text-xs font-bold">+ Nuevo</a>
        <button id="mobile-menu-btn" aria-label="Menú" class="p-2 rounded-lg border border-slate-700 hover:bg-slate-800">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </nav>
    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden md:hidden bg-slate-900 text-white border-t border-slate-800 sticky top-[57px] z-40">
      <div class="flex flex-col p-4 gap-3 text-sm">
        <a href="/" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">Activos</a>
        <a href="/estadisticas" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">📊 Estadísticas</a>
        <a href="/calendario" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">📅 Calendario</a>
        <a href="/etiquetas" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">🏷️ Etiquetas</a>
        <a href="/escaner" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">🔍 Escanear</a>
        <a href="/?estado=dado_de_baja" class="py-2.5 px-3 rounded-lg hover:bg-slate-800">Bajas</a>
        <div id="nav-user-mobile" class="hidden text-xs text-slate-400 px-3 py-2"></div>
        <button id="nav-logout-mobile" class="hidden text-left py-2.5 px-3 rounded-lg bg-slate-800">Salir</button>
      </div>
    </div>
    <script is:inline>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => menu.classList.toggle('hidden'));
        menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.classList.add('hidden')));
      }
      // patch fetch para enviar token automáticamente (componentes React siguen usando fetch sin cambios)
      (function() {
        const origFetch = window.fetch;
        window.fetch = function(input, init = {}) {
          const token = localStorage.getItem('token');
          const url = typeof input === 'string' ? input : input.url;
          // solo para /api mismo origen
          if (token && url && url.includes('/api/')) {
            init.headers = { ...(init.headers || {}), Authorization: 'Bearer ' + token };
          }
          return origFetch(input, init).then(res => {
            const isLogin = location.pathname === '/login' || location.pathname.startsWith('/login/');
            if (res.status === 401 && !isLogin && url && url.includes('/api/')) {
              localStorage.removeItem('token');
              localStorage.removeItem('usuario');
              location.href = '/login';
            }
            return res;
          });
        };
      })();
      // auth guard + user badge (token-based, sin JWT)
      (function() {
        const token = localStorage.getItem('token');
        const raw = localStorage.getItem('usuario');
        const path = location.pathname;
        const isLogin = path === '/login' || path.startsWith('/login/');
        if (!token && !isLogin) {
          location.href = '/login';
          return;
        }
        if (token && raw) {
          try {
            const u = JSON.parse(raw);
            const label = u.username + ' · ' + u.rol;
            const d = document.getElementById('nav-user-desktop');
            const m = document.getElementById('nav-user-mobile');
            const ld = document.getElementById('nav-logout-desktop');
            const lm = document.getElementById('nav-logout-mobile');
            const nuevo = document.getElementById('nav-nuevo-desktop');
            if (d) { d.textContent = label; d.classList.remove('hidden'); }
            if (m) { m.textContent = label; m.classList.remove('hidden'); }
            if (ld) ld.classList.remove('hidden');
            if (lm) lm.classList.remove('hidden');
            if (nuevo && u.rol !== 'tecnico') { nuevo.classList.add('hidden'); }
          } catch {}
        }
        function doLogout() {
          const tok = localStorage.getItem('token');
          if (tok) fetch('/api/auth/logout', { method:'POST', headers:{ Authorization:'Bearer '+tok }}).catch(()=>{});
          localStorage.removeItem('token');
          localStorage.removeItem('usuario');
          location.href = '/login';
        }
        const ld = document.getElementById('nav-logout-desktop');
        const lm = document.getElementById('nav-logout-mobile');
        if (ld) ld.addEventListener('click', doLogout);
        if (lm) lm.addEventListener('click', doLogout);
      })();
    </script>
    <slot />
    <footer class="text-center text-xs text-slate-400 py-8 mt-12 border-t border-slate-200">
      Sistema de Inventario TI — Golang + Astro + AES-256-GCM — {new Date().getFullYear()}
    </footer>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>
