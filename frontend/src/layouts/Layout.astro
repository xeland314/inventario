---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — Inventario TI</title>
    <meta name="description" content="Sistema de Inventario de Tecnología, Mantenimiento y Galería Cifrada" />
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased">
    <nav class="bg-slate-900 text-white px-6 py-4 flex justify-between items-center sticky top-0 z-50">
      <a href="/" class="font-bold text-lg tracking-tight">🖥️ Inventario <span class="text-sky-400">TI</span></a>
      <div class="flex gap-6 text-sm">
        <a href="/" class="hover:text-sky-400 transition">Activos</a>
        <a href="/?estado=dado_de_baja" class="hover:text-rose-400 transition">Bajas</a>
        <a href="/dispositivos/nuevo" class="bg-sky-600 hover:bg-sky-500 px-4 py-1.5 rounded-full text-white font-medium transition">+ Nuevo</a>
      </div>
    </nav>
    <slot />
    <footer class="text-center text-xs text-slate-400 py-8 mt-12 border-t border-slate-200">
      Sistema de Inventario TI — Golang + Astro + AES-256-GCM — {new Date().getFullYear()}
    </footer>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>
