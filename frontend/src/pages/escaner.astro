---
import Layout from '../layouts/Layout.astro';
import Escaner from '../components/Escaner';
---
<Layout title="Escáner">
  <main class="max-w-3xl mx-auto p-6 space-y-6">
    <h1 class="text-2xl font-bold">🔍 Escáner rápido</h1>
    <p class="text-sm text-slate-500">Escanea QR de etiqueta (UUID v4/v7 o ET-XXXX) y abre el dispositivo asociado.</p>
    <div id="escaner-mount"></div>
    <Escaner client:load onDeviceFound={(data) => {
      // handled inside Escaner, extra redirect if needed via window
    }} />
    <script is:inline>
      // Escucha evento de escaneo y redirige si hay dispositivo
      window.addEventListener('message', (e) => {
        if (e.data && e.data.dispositivo) {
          window.location.href = '/dispositivos/' + e.data.dispositivo.id;
        }
      });
    </script>
  </main>
</Layout>
