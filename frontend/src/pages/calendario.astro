---
import Layout from '../layouts/Layout.astro';
import CalendarioMantenimiento from '../components/CalendarioMantenimiento';
---
<Layout title="Calendario">
  <main class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">
    <header class="flex flex-col sm:flex-row justify-between gap-3">
      <div>
        <h1 class="text-3xl font-black text-slate-900">📅 Calendario de Mantenimientos</h1>
        <p class="text-sm text-slate-500 mt-1">Vista tipo Google Calendar — mantenimientos realizados + planes programados · ICS exportable</p>
      </div>
      <div class="flex gap-2 items-start">
        <a href="/estadisticas" class="text-xs bg-white border border-slate-200 px-4 py-2 rounded-full font-semibold hover:bg-slate-50">📊 Estadísticas</a>
        <a href="/" class="text-xs bg-slate-900 text-white px-4 py-2 rounded-full font-semibold">← Inventario</a>
      </div>
    </header>
    <CalendarioMantenimiento client:load />
  </main>
</Layout>
