---
import Layout from '../layouts/Layout.astro';
import CalendarioMantenimiento from '../components/CalendarioMantenimiento';
---
<Layout title="Calendario">
  <main class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">
    <header class="flex flex-col sm:flex-row justify-between gap-3">
      <div>
        <h1 class="text-3xl font-black text-slate-900 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> Calendario de Mantenimientos</h1>
        <p class="text-sm text-slate-500 mt-1">Vista tipo Google Calendar — mantenimientos realizados + planes programados · ICS exportable</p>
      </div>
      <div class="flex gap-2 items-start">
        <a href="/estadisticas" class="text-xs bg-white border border-slate-200 px-4 py-2 rounded-full font-semibold hover:bg-slate-50 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg> Estadísticas</a>
        <a href="/" class="text-xs bg-slate-900 text-white px-4 py-2 rounded-full font-semibold">← Inventario</a>
      </div>
    </header>
    <CalendarioMantenimiento client:load />
  </main>
</Layout>
