---
import Layout from '../../layouts/Layout.astro';
import Escaner from '../../components/Escaner';
import FotosCreacion from '../../components/FotosCreacion';
---

<Layout title="Nuevo dispositivo">
  <main class="max-w-3xl mx-auto p-6">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Alta de nuevo dispositivo</h1>
    <form id="form-nuevo" class="bg-white border border-slate-200 rounded-2xl p-6 space-y-4 shadow-sm">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-slate-600">Código Activo *</label>
          <input name="codigo_activo" required placeholder="INV-2026-001" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Número de Serie</label>
          <input name="numero_serie" placeholder="SN123456 (opcional)" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <label class="text-xs font-semibold text-slate-600">Tipo *</label>
          <select name="tipo" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm">
            <option>Desktop</option>
            <option>Laptop</option>
            <option>Servidor</option>
            <option>Tablet</option>
            <option>Monitor</option>
            <option>Proyector</option>
            <option>Impresora</option>
            <option>Scanner</option>
            <option>Router</option>
            <option>Switch</option>
            <option>Access Point</option>
            <option>Firewall</option>
            <option>NAS</option>
            <option>UPS</option>
            <option>Regulador</option>
            <option>Telefono IP</option>
            <option>Radio Comunicador</option>
            <option>Camara IP</option>
            <option>Disco Externo</option>
            <option>Mouse</option>
            <option>Teclado</option>
            <option>Parlante</option>
            <option>Microfono</option>
            <option>Camara</option>
            <option>Pantalla</option>
            <option>Audifono</option>
            <option>Auricular</option>
            <option>Cargador</option>
            <option>Otro</option>
          </select>
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Marca *</label>
          <input name="marca" required placeholder="HP, Dell..." class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Modelo *</label>
          <input name="modelo" required placeholder="ProBook 450" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-600">Especificaciones (JSON o texto)</label>
        <textarea name="especificaciones" rows="2" placeholder='{"cpu":"i7-12700","ram":"16GB","disco":"512GB SSD"}' class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono"></textarea>
      </div>

      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <label class="text-xs font-semibold text-slate-600">Valor compra</label>
          <input name="valor_compra" type="number" step="0.01" placeholder="0.00" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Proveedor</label>
          <input name="proveedor" placeholder="Proveedor S.A." class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Ubicación</label>
          <input name="ubicacion" placeholder="Piso 2, Sala Servidores..." class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-slate-600">Asignado a</label>
          <input name="asignado_a" placeholder="correo@empresa.com" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Fecha compra</label>
          <input name="fecha_compra" type="date" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-600">Estado inicial</label>
        <select name="estado" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm">
          <option value="activo">Activo</option>
          <option value="disponible">Disponible</option>
          <option value="reserva">Reserva (alias disponible)</option>
          <option value="en_mantenimiento">En Mantenimiento</option>
          <option value="en_reparacion">En Reparación</option>
          <option value="averiado">Averiado</option>
          <option value="obsoleto">Obsoleto</option>
          <option value="extraviado">Extraviado</option>
        </select>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="text-xs font-semibold text-slate-600">Sede</label>
          <input name="sede" placeholder="Matriz / Icon / Vicsan..." class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm" />
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-600">Tipo Componente (si es componente)</label>
          <select name="tipo_componente" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm">
            <option value="">— No es componente —</option>
            <option>Ventilador</option>
            <option>SSD</option>
            <option>HDD</option>
            <option>NVMe</option>
            <option>RAM</option>
            <option>Bateria</option>
            <option>Fuente</option>
            <option>Placa</option>
            <option>CPU</option>
            <option>GPU</option>
            <option>Teclado</option>
            <option>Pantalla</option>
            <option>Cargador</option>
            <option>Disco</option>
            <option>Disco Externo</option>
            <option>Cable Poder</option>
            <option>Cable HDMI</option>
            <option>Cable VGA</option>
            <option>Cable DisplayPort</option>
            <option>Cable Ethernet</option>
            <option>Cable USB</option>
            <option>Cable SATA</option>
            <option>Patch Cord</option>
            <option>Adaptador</option>
            <option>Regulador</option>
            <option>UPS</option>
            <option>Bateria UPS</option>
            <option>Fusible</option>
            <option>Tarjeta Red</option>
            <option>Mouse</option>
            <option>Parlante</option>
            <option>Microfono</option>
            <option>Camara</option>
            <option>Disipador</option>
            <option>Otro</option>
          </select>
        </div>
      </div>
      <div>
        <label class="text-xs font-semibold text-slate-600">Parent ID (si es componente dentro de otro equipo)</label>
        <input name="parent_id" placeholder="UUID del padre, o UUID/ET-XXXX de su etiqueta QR" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono" />
        <p class="text-xs text-slate-400 mt-1">Acepta el UUID del equipo padre o directamente el QR escaneado de su etiqueta (se resuelve automáticamente). Dejar vacío si es independiente.</p>
      </div>

      <div>
        <label class="text-xs font-semibold text-slate-600">Etiqueta UUID (opcional — escanea el QR de la etiqueta)</label>
        <input name="etiqueta_id" placeholder="UUID v4/v7 o ET-XXXX (auto al escanear)" class="w-full mt-1 border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono" />
        <p class="text-xs text-slate-400 mt-1">Si la etiqueta ya está asignada a otro equipo se mostrará un error; usa una etiqueta disponible.</p>
      </div>

      <FotosCreacion client:load />

      <button type="submit" class="w-full bg-sky-600 hover:bg-sky-500 text-white font-semibold py-3 rounded-xl transition">Crear dispositivo</button>
      <p id="msg" class="text-sm text-center"></p>
    </form>

    <div class="mt-6 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <h2 class="font-bold text-slate-900 text-base inline-flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg>
        Escanear etiqueta en línea
      </h2>
      <p class="text-xs text-slate-500 mt-1">Escanea el QR de la etiqueta y se completará automáticamente en el formulario.</p>
      <Escaner client:load />
    </div>
  </main>

  <script is:inline>
    document.getElementById('form-nuevo').addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const payload = {
        codigo_activo: fd.get('codigo_activo'),
        numero_serie: fd.get('numero_serie'),
        tipo: fd.get('tipo'),
        marca: fd.get('marca'),
        modelo: fd.get('modelo'),
        especificaciones: fd.get('especificaciones'),
        valor_compra: parseFloat(fd.get('valor_compra')) || 0,
        proveedor: fd.get('proveedor'),
        ubicacion: fd.get('ubicacion'),
        asignado_a: fd.get('asignado_a') || null,
        fecha_compra: fd.get('fecha_compra'),
        estado: fd.get('estado'),
        sede: fd.get('sede') || null,
        tipo_componente: fd.get('tipo_componente') || null,
        parent_id: fd.get('parent_id') || null,
        etiqueta_id: fd.get('etiqueta_id')?.toString().trim() || null,
      };
      if (!payload.tipo_componente) delete payload.tipo_componente;
      if (!payload.parent_id) delete payload.parent_id;
      if (!payload.sede) delete payload.sede;
      if (!payload.etiqueta_id) delete payload.etiqueta_id;
      const msg = document.getElementById('msg');
      msg.textContent = 'Guardando...';
      msg.className = 'text-sm text-slate-500 text-center';
      const res = await fetch('/api/dispositivos', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(payload)});
      let data = {};
      let errorText = '';
      try {
        data = await res.clone().json();
        errorText = data.error || data.message || JSON.stringify(data);
      } catch {
        errorText = await res.text();
      }
      if (res.ok) {
        const nuevoId = data.id;
        const fotos = (window.__fotosCreacion || []);
        let advertencia = '';
        if (fotos.length) {
          msg.textContent = '✓ Creado. Subiendo ' + fotos.length + ' foto(s)...';
          msg.className = 'text-sm text-slate-500 text-center';
          try {
            for (const blob of fotos) {
              const fform = new FormData();
              fform.append('entidad_tipo', 'dispositivo');
              fform.append('entidad_id', nuevoId);
              fform.append('fotos', new File([blob], 'captura_' + Date.now() + '.jpg', { type: 'image/jpeg' }));
              const fr = await fetch('/api/evidencia/upload', { method: 'POST', body: fform });
              if (!fr.ok) advertencia = await fr.text();
            }
          } catch (fe) {
            advertencia = 'Fallo de red al subir fotos: ' + fe.message;
          }
        }
        msg.textContent = '✓ Creado correctamente' + (fotos.length ? ' con ' + fotos.length + ' foto(s)' : '') + (advertencia ? ' (advertencia: ' + advertencia + ')' : '') + '. Redirigiendo...';
        msg.className = advertencia ? 'text-sm text-amber-600 text-center' : 'text-sm text-emerald-600 text-center';
        window.__fotosCreacion = [];
        setTimeout(() => location.href = `/dispositivos/${nuevoId}`, advertencia ? 2500 : 600);
      } else {
        if (res.status === 409 && errorText.includes('UNIQUE')) {
          errorText = `El código "${payload.codigo_activo}" ya existe (CO1431MT042300119 es un Parlante registrado). Usa un código único o edita el existente.`;
        } else if (!errorText || errorText === '{}') {
          errorText = `Error ${res.status} — verifica campos obligatorios (código, serie, tipo, marca, modelo)`;
        }
        msg.textContent = 'Error: ' + errorText;
        msg.className = 'text-sm text-rose-600 text-center whitespace-pre-wrap';
      }
    });

    // Escáner integrado: rellena el campo etiqueta_id al escanear
    window.addEventListener('escaner:scan', (e) => {
      const input = document.querySelector('input[name="etiqueta_id"]');
      if (input && e.detail?.uuid) {
        input.value = e.detail.uuid;
        input.classList.add('border-emerald-400', 'ring-1', 'ring-emerald-300');
        setTimeout(() => input.classList.remove('border-emerald-400', 'ring-1', 'ring-emerald-300'), 2500);
      }
    });
  </script>
</Layout>
