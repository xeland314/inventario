---
import Layout from '../layouts/Layout.astro';
import FrascosManager from '../components/FrascosManager';
---
<Layout title="Frascos de Tinta">
  <main class="max-w-6xl mx-auto p-4 sm:p-6 space-y-6">
    <header class="flex flex-col sm:flex-row justify-between gap-3">
      <div>
        <h1 class="text-3xl font-black text-slate-900 inline-flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v8"/><path d="M12 22a7 7 0 0 0 7-7c0-3.5-2-6-7-11-5 5-7 7.5-7 11a7 7 0 0 0 7 7z"/></svg> Frascos de Tinta</h1>
        <p class="text-sm text-slate-500 mt-1">Stock consumible sin QR — distinto de <strong>tinta en impresora</strong> (nivel %). Ingreso / consumo con trazabilidad por lote y sede.</p>
      </div>
      <div class="flex gap-2 items-start">
        <a href="/estadisticas" class="text-xs bg-white border border-slate-200 px-4 py-2 rounded-full font-semibold hover:bg-slate-50 inline-flex items-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg> Estadísticas</a>
        <a href="/" class="text-xs bg-slate-900 text-white px-4 py-2 rounded-full font-semibold">← Inventario</a>
      </div>
    </header>
    <FrascosManager client:load />
  </main>
</Layout>
